# ── GreenBuddy environment variables ─────────────────────────────────
# Copy this to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed.

DB_URL=jdbc:mysql://localhost:3306/greenbuddy
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

GEMINI_API_KEY=your_gemini_api_key_here
WEATHER_API_KEY=your_openweathermap_api_key_here

# Generate a strong random secret (min 64 chars)
JWT_SECRET=your_strong_random_jwt_secret_at_least_64_chars_here
