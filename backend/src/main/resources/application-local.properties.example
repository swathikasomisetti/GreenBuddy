# ── Local development overrides ──────────────────────────────────────
# Copy this file to application-local.properties and fill in your values.
# application-local.properties is git-ignored and must NEVER be committed.

spring.datasource.url=jdbc:mysql://localhost:3306/greenbuddy
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD_HERE

gemini.api.key=YOUR_GEMINI_API_KEY_HERE
weather.api.key=YOUR_OPENWEATHERMAP_API_KEY_HERE

# Generate a strong secret: at least 64 characters, random
jwt.secret=YOUR_STRONG_RANDOM_JWT_SECRET_AT_LEAST_64_CHARS_HERE
